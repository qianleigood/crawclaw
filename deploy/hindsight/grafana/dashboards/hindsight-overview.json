{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "服务状态",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"hindsight\"}", "legendFormat": "Hindsight" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "text": "离线", "color": "red" },
                "1": { "text": "在线", "color": "green" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "请求速率 (QPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum(rate(hindsight_http_requests_total[5m]))", "legendFormat": "总 QPS" },
        {
          "expr": "sum(rate(hindsight_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx QPS"
        }
      ]
    },
    {
      "title": "操作延迟 P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hindsight_operation_duration_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "{{ operation }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Recall 延迟分布",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(hindsight_operation_duration_seconds_bucket{operation=\"recall\"}[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(hindsight_operation_duration_seconds_bucket{operation=\"recall\"}[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(hindsight_operation_duration_seconds_bucket{operation=\"recall\"}[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Retain 延迟分布",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(hindsight_operation_duration_seconds_bucket{operation=\"retain\"}[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(hindsight_operation_duration_seconds_bucket{operation=\"retain\"}[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(hindsight_operation_duration_seconds_bucket{operation=\"retain\"}[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "LLM Token 使用量",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(hindsight_llm_tokens_input_total[5m]))",
          "legendFormat": "输入 token/s"
        },
        {
          "expr": "sum(rate(hindsight_llm_tokens_output_total[5m]))",
          "legendFormat": "输出 token/s"
        }
      ]
    },
    {
      "title": "错误率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(hindsight_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(hindsight_http_requests_total[5m]))",
          "legendFormat": "5xx 错误率"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "title": "容器内存使用",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"crawclaw.*\"}",
          "legendFormat": "{{ name }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "容器 CPU 使用",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"crawclaw.*\"}[5m])",
          "legendFormat": "{{ name }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["hindsight", "crawclaw"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Hindsight 概览",
  "uid": "hindsight-overview"
}
