# ============================================
# Hindsight 中文优化配置
# ============================================

# --- LLM 提供商（用于记忆提取）---
# MiniMax 使用 OpenAI-compatible API 口径
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=${MINIMAX_API_KEY}
HINDSIGHT_API_LLM_MODEL=MiniMax-M2.7
HINDSIGHT_API_LLM_BASE_URL=${MINIMAX_BASE_URL}

# 或使用 Anthropic（推荐中文场景）
# HINDSIGHT_API_LLM_PROVIDER=anthropic
# HINDSIGHT_API_LLM_API_KEY=${ANTHROPIC_API_KEY}
# HINDSIGHT_API_LLM_MODEL=claude-3-5-haiku-20241022

# --- 嵌入模型（中文必需）---
# 单容器默认使用中文友好的多语言 embedding；安装脚本会按硬件自动降级/预热
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-m3

# --- 重排序模型（中文必需）---
# 桌面本地使用 RRF，避免首次启动下载 reranker 模型导致 Hindsight 300s 启动超时
HINDSIGHT_API_RERANKER_PROVIDER=rrf

# --- BM25 后端 ---
# 开发单容器使用 Hindsight embedded PostgreSQL，没有 pgroonga 扩展；生产栈再启用 pgroonga
HINDSIGHT_API_TEXT_SEARCH_EXTENSION=native
HINDSIGHT_API_TEXT_SEARCH_EXTENSION_NATIVE_LANGUAGE=simple

# 备选方案：pg_search + jieba 分词器（如果使用 ParadeDB）
# HINDSIGHT_API_TEXT_SEARCH_EXTENSION=pg_search
# HINDSIGHT_API_TEXT_SEARCH_EXTENSION_PG_SEARCH_TOKENIZER=jieba

# --- LLM 输出语言 ---
# 留空 = 跟随输入语言（中文输入 → 中文提取）
# 设为 Chinese = 强制所有输出为中文
# HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=Chinese

# --- API 配置 ---
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_HOST=0.0.0.0

# --- 数据库（默认使用内嵌 PostgreSQL）---
# 生产环境建议使用外部 PostgreSQL
# HINDSIGHT_API_DATABASE_URL=postgresql://user:pass@host:5432/hindsight
